<odoo>
    <template id="report_saleorder_document_hide_description"
              inherit_id="sale.report_saleorder_document">

        <xpath expr="//td[@name='td_product_name']//span[@t-field='line.label']"
               position="replace">
            <span class="d-inline-block w-100 lh-sm"
                  t-out="line.product_id.name or line.label"/>
        </xpath>

    </template>

    <template id="report_invoice_document_only_name"
              inherit_id="account.report_invoice_document">

        <xpath expr="//td[@name='account_invoice_line_name']/span" position="replace">
            <span t-out="line.product_id.name or line.name"/>
        </xpath>

    </template>


    <template id="report_delivery_name_only" inherit_id="stock.report_delivery_document">
        <xpath expr="/*/*[1]" position="before">
            <t t-set="o" t-value="o.with_context(display_default_code=False)"/>
        </xpath>
    </template>

    <template id="report_picking_name_only" inherit_id="stock.report_picking">
        <xpath expr="/*/*[1]" position="before">
            <t t-set="docs" t-value="docs.with_context(display_default_code=False)"/>
        </xpath>
    </template>

    <template id="report_purchaseorder_hide_internal_reference"
              inherit_id="purchase.report_purchaseorder_document">

        <xpath expr="//td[@id='product']/span[@t-field='line.label']"
               position="replace">

            <!-- Show only Product Name -->
            <span t-field="line.product_id.name"/>

        </xpath>

    </template>

    <template id="report_purchasequotation_product_name_only"
              inherit_id="purchase.report_purchasequotation_document">

        <xpath expr="//td[@id='product']/span[@t-field='order_line.label']"
               position="replace">
            <span t-field="order_line.product_id.name"/>
        </xpath>

    </template>
</odoo>