<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Product Template Form -->
    <record id="product_template_form_inherit_reference_note" model="ir.ui.view">
        <field name="name">product.template.form.reference.note</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='is_storable']" position="after">
                <field name="reference_note"/>
            </xpath>
        </field>
    </record>

    <!-- Product Variant Form -->
    <record id="product_product_form_inherit_reference_note" model="ir.ui.view">
        <field name="name">product.product.form.reference.note</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='is_storable']" position="after">
                <field name="reference_note"/>
            </xpath>
        </field>
    </record>


    <record id="sale_order_form_inherit_reference" model="ir.ui.view">
        <field name="name">sale.order.form.reference.note</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- Sale Order Line Form -->
            <xpath expr="//field[@name='order_line']/form//field[@name='product_uom_qty']"
                   position="before">

                <field name="reference_note"
                       string="Product Description"/>

            </xpath>

            <!-- Sale Order Line List -->
            <xpath expr="//field[@name='order_line']//list/column[@name='sol_qty']"
                   position="before">

                <column name="reference_note"
                        string="Product Description"
                        width="150px">

                    <field name="reference_note"
                           string="Product Description"
                           optional="show"
                           widget="text"/>

                </column>

            </xpath>

        </field>
    </record>


    <!-- Invoice Line -->
    <record id="view_move_form_inherit_reference_note"
            model="ir.ui.view">

        <field name="name">account.move.form.reference.note</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>

        <field name="arch" type="xml">

            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='quantity']"
                   position="before">

                <field name="reference_note"
                       string="Product Description"
                       optional="show"
                       width="150px"/>

            </xpath>

        </field>
    </record>
</odoo>