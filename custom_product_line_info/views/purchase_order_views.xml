<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_inherit_custom" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.custom</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <!-- Product column hide (product_and_description column ke andar) -->
            <xpath expr="//field[@name='order_line']/list/column[@name='product_and_description']/field[@name='product_id']" position="attributes">
                <attribute name="context">{'partner_id': partner_id, 'quantity': product_qty, 'company_id': parent.company_id, 'display_default_code': False}</attribute>
                <attribute name="column_invisible">1</attribute>
            </xpath>

            <!-- Standard 'name' column hide (product_and_description column ke andar) -->
            <xpath expr="//field[@name='order_line']/list/column[@name='product_and_description']/field[@name='name']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>

            <!-- product_id ke baad Internal Ref (searchable) aur Description -->
            <xpath expr="//field[@name='order_line']/list/column[@name='product_and_description']/field[@name='product_id']" position="after">
                <field name="product_ref_id" optional="show"
                       context="{'internal_ref_search': True}"
                       options="{'no_create': True, 'no_open': True}"
                       readonly="parent.state in ('purchase', 'done', 'cancel')"/>
                <field name="product_description" optional="show"/>
            </xpath>

            <!-- Location aur Unit Quantity add karein (product_qty ke baad) -->
            <xpath expr="//field[@name='order_line']/list/field[@name='product_qty']" position="after">
                <field name="location_id" optional="show" domain="[]" options="{'no_create': True, 'no_open': True}"/>
                <field name="unit_quantity" optional="show" readonly="1"/>
            </xpath>

            <!-- Discount readonly in amount mode -->
            <xpath expr="//field[@name='order_line']/list/field[@name='discount']" position="attributes">
                <attribute name="readonly">qty_invoiced != 0 or discount_mode == 'amount'</attribute>
            </xpath>

            <!-- Fixed Amount add karein -->
            <xpath expr="//field[@name='order_line']/list/field[@name='discount']" position="after">
                <field name="discount_mode" column_invisible="1"/>
                <field name="fixed_amount" optional="show" readonly="qty_invoiced != 0 or discount_mode == 'percent'"/>
            </xpath>

            <!-- Expected Arrival (date_planned) ko required=false -->
            <xpath expr="//field[@name='order_line']/list/field[@name='date_planned']" position="attributes">
                <attribute name="required">0</attribute>
            </xpath>

        </field>
    </record>
</odoo>