<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_custom" model="ir.ui.view">
        <field name="name">account.move.form.inherit.custom</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- Product_id column hide (column ke andar) -->
            <xpath expr="//field[@name='invoice_line_ids']/list/column[@name='product_and_description']/field[@name='product_id']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>

            <!-- product_id ke baad Internal Ref + Description add -->
            <xpath expr="//field[@name='invoice_line_ids']/list/column[@name='product_and_description']/field[@name='product_id']" position="after">
                <field name="product_ref_id" optional="show"
                       context="{'internal_ref_search': True}"
                       options="{'no_create': True, 'no_open': True}"
                       readonly="parent.state != 'draft'"/>
                <field name="product_description" optional="show"/>
            </xpath>

            <!-- Location aur Unit Quantity add (quantity ke baad) -->
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='quantity']" position="after">
                <field name="location_id" optional="show" domain="[]" options="{'no_create': True, 'no_open': True}"/>
                <field name="unit_quantity" optional="show" readonly="1"/>
            </xpath>

        </field>
    </record>
</odoo>