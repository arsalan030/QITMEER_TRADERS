<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_custom" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.custom</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">

            <!-- Product_id column hide (koi bhi depth me) -->
            <xpath expr="//field[@name='move_ids']//field[@name='product_id']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>

            <!-- product_id ke baad product_ref_id + product_description add karo -->
            <xpath expr="//field[@name='move_ids']//field[@name='product_id']" position="after">
                <field name="product_ref_id" optional="show"
                       context="{'internal_ref_search': True}"
                       options="{'no_create': True, 'no_open': True}"
                       readonly="parent.state in ('done', 'cancel')"/>
            </xpath>

            <!-- description_picking ke baad product_description add karo -->
            <xpath expr="//field[@name='move_ids']//field[@name='description_picking']" position="after">
                <field name="product_description" optional="show"/>
            </xpath>

            <!-- product_uom_qty ke baad location_id + unit_quantity add karo -->
            <xpath expr="//field[@name='move_ids']//field[@name='product_uom_qty']" position="after">
                <field name="location_id" optional="show" domain="[]" options="{'no_create': True, 'no_open': True}"/>
                <field name="unit_quantity" optional="show" readonly="1"/>
            </xpath>

        </field>
    </record>
</odoo>