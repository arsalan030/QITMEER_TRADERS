<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_custom" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.custom</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- Standard Product Template hide -->
            <xpath expr="//field[@name='order_line']/list/column[@name='product_and_description']/field[@name='product_template_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Standard 'name' sirf Section/Note lines ke liye -->
            <xpath expr="//field[@name='order_line']/list/column[@name='product_and_description']/field[@name='name']" position="attributes">
                <attribute name="invisible">not display_type</attribute>
            </xpath>

            <!-- Yahan hum original product_id ko visible kar rahe hain taake Product ka Naam aaye -->
            <xpath expr="//field[@name='order_line']/list/column[@name='product_and_description']/field[@name='product_id']" position="attributes">
                <attribute name="optional">show</attribute>
                <attribute name="invisible">display_type</attribute>
            </xpath>

            <!-- product_id ke baad Search field (jo list me hide hai) aur Notes add karein -->
            <xpath expr="//field[@name='order_line']/list/column[@name='product_and_description']/field[@name='product_id']" position="after">

                <!-- Internal Ref Search Box (List me nahi dikhega, column_invisible=1) -->
                <field name="product_ref_id" optional="hide"
                       context="{'internal_ref_search': True}"
                       options="{'no_create': True, 'no_open': True}"
                       column_invisible="1"/>

                <!-- Internal Notes (Description) -->
                <field name="product_description" optional="show" invisible="display_type"/>
            </xpath>

            <!-- Location aur Unit Quantity -->
            <xpath expr="//field[@name='order_line']/list/column[@name='sol_qty']/field[@name='product_uom_qty']" position="after">
                <field name="location_id" optional="show" domain="[]" options="{'no_create': True, 'no_open': True}"/>
                <field name="unit_quantity" optional="show" readonly="1"/>
            </xpath>

            <!-- Discount -->
            <xpath expr="//field[@name='order_line']/list/field[@name='discount']" position="attributes">
                <attribute name="readonly">discount_mode == 'amount'</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='discount']" position="after">
                <field name="discount_mode" column_invisible="1"/>
                <field name="fixed_amount" optional="show" readonly="discount_mode == 'percent'"/>
            </xpath>

        </field>
    </record>
</odoo>