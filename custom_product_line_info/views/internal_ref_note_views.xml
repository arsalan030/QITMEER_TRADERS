<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Sale Order line: Internal Ref column product se pehle -->
    <record id="view_order_form_kitmeer_internal_ref" model="ir.ui.view">
        <field name="name">sale.order.form.kitmeer.internal.ref</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/column[@name='product_and_description']/field[@name='product_id']" position="before">
                <field name="kitmeer_internal_ref"
                       string="Internal Ref"
                       optional="show"
                       placeholder="Product Code likhein..."/>
            </xpath>
        </field>
    </record>

    <!-- RFQ / Purchase Order line: Internal Ref column product se pehle -->
    <record id="purchase_order_form_kitmeer_internal_ref" model="ir.ui.view">
        <field name="name">purchase.order.form.kitmeer.internal.ref</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/column[@name='product_and_description']/field[@name='product_id']" position="before">
                <field name="kitmeer_internal_ref"
                       string="Internal Ref"
                       optional="show"
                       placeholder="Product Code likhein..."/>
            </xpath>
        </field>
    </record>

</odoo>