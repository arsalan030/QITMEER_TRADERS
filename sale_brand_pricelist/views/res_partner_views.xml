<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_brand_pricelist" model="ir.ui.view">
        <field name="name">res.partner.form.brand.pricelist</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Brand Pricelists" name="brand_pricelists"
                      groups="sales_team.group_sale_salesman"
                      invisible="parent_id">
                    <field name="brand_pricelist_ids">
                        <list editable="bottom">
                            <field name="brand_id" options="{'no_create': True}"/>
                            <field name="pricelist_id" options="{'no_create': True}"/>
                            <field name="currency_id" optional="hide"/>
                        </list>
                    </field>
                    <div class="text-muted">
                        Products of these brands are priced from the selected pricelist on
                        sale orders. Other brands use the customer's normal pricelist.
                    </div>
                </page>
            </xpath>
        </field>
    </record>

    <record id="action_partner_brand_pricelist" model="ir.actions.act_window">
        <field name="name">Customer Brand Pricelists</field>
        <field name="res_model">res.partner.brand.pricelist</field>
        <field name="view_mode">list</field>
    </record>

    <record id="partner_brand_pricelist_view_list" model="ir.ui.view">
        <field name="name">res.partner.brand.pricelist.list</field>
        <field name="model">res.partner.brand.pricelist</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="partner_id"/>
                <field name="brand_id"/>
                <field name="pricelist_id"/>
            </list>
        </field>
    </record>

    <record id="partner_brand_pricelist_view_search" model="ir.ui.view">
        <field name="name">res.partner.brand.pricelist.search</field>
        <field name="model">res.partner.brand.pricelist</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="brand_id"/>
                <field name="pricelist_id"/>
                <filter name="groupby_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                <filter name="groupby_brand" string="Brand" context="{'group_by': 'brand_id'}"/>
            </search>
        </field>
    </record>

    <menuitem id="menu_partner_brand_pricelist"
              name="Customer Brand Pricelists"
              parent="sale.menu_sale_config"
              action="action_partner_brand_pricelist"
              sequence="31"/>
</odoo>
