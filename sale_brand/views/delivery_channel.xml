<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="delivery_channel_view_list" model="ir.ui.view">
        <field name="name">delivery.channel.list</field>
        <field name="model">delivery.channel</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="delivery_channel_view_form" model="ir.ui.view">
        <field name="name">delivery.channel.form</field>
        <field name="model">delivery.channel</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <field name="name"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="delivery_channel_view_search" model="ir.ui.view">
        <field name="name">delivery.channel.search</field>
        <field name="model">delivery.channel</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_delivery_channel" model="ir.actions.act_window">
        <field name="name">Delivery Channel</field>
        <field name="res_model">delivery.channel</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_delivery_channel"
              name="Delivery Channel"
              parent="sale.menu_sale_config"
              action="action_delivery_channel"
              sequence="32"/>
</odoo>